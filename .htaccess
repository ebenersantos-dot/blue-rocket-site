# Blue Rocket Co. — Apache / cPanel configuration
# ─────────────────────────────────────────────────────────────────────

# ── Security headers ─────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "DENY"

    # Stop MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Enable XSS filter (older browsers)
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer policy — don't leak the full URL to third parties
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions policy — disable features we don't use
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content Security Policy
    # - default: only self
    # - scripts: self + React CDN (cdn.jsdelivr.net)
    # - styles: self + Google Fonts
    # - fonts: self + Google Fonts
    # - connect: self + FormSubmit fallback + bluerocketcompany.com
    # - img: self + data URIs (country flags are inline SVG data URIs)
    Header always set Content-Security-Policy "\
        default-src 'self'; \
        script-src 'self' https://cdn.jsdelivr.net https://unpkg.com; \
        style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
        font-src 'self' https://fonts.gstatic.com; \
        connect-src 'self' https://bluerocketcompany.com; \
        img-src 'self' data:; \
        frame-ancestors 'none'; \
        base-uri 'self'; \
        form-action 'self';"

    # HSTS — tell browsers to always use HTTPS (max 1 year)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ── HTTPS redirect ───────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect HTTP → HTTPS
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_X_FORWARDED_PROTO} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Remove www (optional — comment out if you prefer www)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Compression ──────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript \
        application/json image/svg+xml font/woff2
</IfModule>

# ── Caching ──────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — short cache, re-validate on every visit
    ExpiresByType text/html                 "access plus 1 hour"

    # CSS and JS — fingerprint in filenames for longer cache
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"

    # Assets
    ExpiresByType image/svg+xml             "access plus 1 month"
    ExpiresByType image/png                 "access plus 1 month"
    ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# ── Block sensitive files ─────────────────────────────────────────────
<FilesMatch "(\.(git|env|log|sh|sql|bak|swp|DS_Store)|composer\.(json|lock)|package(-lock)?\.json|README\.md|LICENSE)$">
    Require all denied
</FilesMatch>

# ── Disable directory listing ─────────────────────────────────────────
Options -Indexes

# ── Default document ──────────────────────────────────────────────────
DirectoryIndex index.html index.php
